[Unit]
Description=AMSKY02 Sensor Viewer Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=roman
Group=roman
WorkingDirectory=/var/lib/amsky02
Environment=HOME=/home/roman
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/local/bin/amsky-cli --tcp 2000 --no-tui --log
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
